<Window x:Class="FiveMVehicleBuilder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FiveMVehicleBuilder.App.Views"
        xmlns:vm="clr-namespace:FiveMVehicleBuilder.App.ViewModels"
        mc:Ignorable="d"
        Title="FiveM Vehicle Builder"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:RecordListViewModel}">
            <views:RecordListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PackListViewModel}">
            <views:PackListView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceHoverBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo/Title -->
                <StackPanel Grid.Row="0" Margin="16">
                    <TextBlock Text="FiveM"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Vehicle Builder"
                               FontSize="14"
                               Foreground="{StaticResource ForegroundDimBrush}"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="8,0">
                    <Button Content="Records"
                            Command="{Binding ShowRecordsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewName}" Value="Records">
                                        <Setter Property="Background" Value="#094771"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Packs"
                            Command="{Binding ShowPacksCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewName}" Value="Packs">
                                        <Setter Property="Background" Value="#094771"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Library Info -->
                <Border Grid.Row="2"
                        Background="{StaticResource BackgroundBrush}"
                        Padding="12"
                        Margin="8"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Bibliothek"
                                   FontSize="11"
                                   Foreground="{StaticResource ForegroundDimBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding LibraryPath}"
                                   FontSize="11"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LibraryPath}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"/>

        <!-- Loading Overlay -->
        <Border Grid.Column="0" Grid.ColumnSpan="2"
                Background="#cc1e1e1e"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="{Binding BusyMessage}"
                           Foreground="{StaticResource ForegroundDimBrush}"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
